layout {

    focus-ring {
        active-color   "#85b2c7"
        inactive-color "#1a2023"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#85b2c7"
        inactive-color "#1a2023"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#85b2c7"
        inactive-color "#2a596f"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#85b2c780"
    }
}

recent-windows {
    highlight {
        active-color "#85b2c7"
        urgent-color "#fd4663"
    }
}
