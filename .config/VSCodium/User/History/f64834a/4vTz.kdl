layout {

    focus-ring {
        active-color   "#b4befe"
        inactive-color "#1e1e2e"
        urgent-color   "#f38ba8"
    }

    border {
        active-color   "#b4befe"
        inactive-color "#1e1e2e"
        urgent-color   "#f38ba8"
    }

    shadow {
        color "#11111b70"
    }

    tab-indicator {
        active-color   "#b4befe"
        inactive-color "#0123ff"
        urgent-color   "#f38ba8"
    }

    insert-hint {
        color "#b4befe80"
    }
}

recent-windows {
    highlight {
        active-color "#b4befe"
        urgent-color "#f38ba8"
    }
}

// Floating Noctalia settings window.
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}