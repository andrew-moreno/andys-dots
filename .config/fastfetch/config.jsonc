// Inspired by Catnap (https://github.com/iinsertNameHere/catnap)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/.config/fastfetch/logos/avatar.jpg",
    	"height": 17,
       	"type": "kitty",  
       	"padding": {
       		"top": 1,
       		"left": 3
       	}      
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#31} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#32}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {#33}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {#34}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#34} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#35}󰇄 desktop {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {#36} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#36} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#31}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
        	"key": "│ {#32}󰌢 mb      {#keys}│",
            "type": "host"
        },
        {
            "key": "│ {#33}󰍛 gpu     {#keys}│",
            "type": "gpu",
            "hideType": "integrated"
        },
        {
            "key": "│ {#34}󰉉 linux   {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#34}󰉉 shared  {#keys}│",
            "type": "disk",
            "folders": "/home/amoreno/Shared"
        },
        {
            "key": "│ {#35} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
